{
  "schemaVersion": 1,
  "id": "spiral-active",
  "name": "Nouvelle interface — Premium",
  "description": "Accueil architectural avec quatre bâtiments indépendants, trois plans de végétation, animation de formation, bâtiments interactifs et surfaces claires.",
  "version": 8,
  "colors": {
    "main": "#F26426",
    "dark": "#14202C",
    "light": "#FFF4EA"
  },
  "startup": {
    "preset": "metra-spiral-active",
    "durationMs": 2100,
    "backgroundColor": "#F4F1E8",
    "replaceable": true,
    "completion": "js-animation-end",
    "provider": "react-native-svg"
  },
  "spiralDock": {
    "diameterTablet": 220,
    "diameterPhone": 176,
    "visibleRatio": 0.55,
    "touchDiameterTablet": 276,
    "appearanceProvider": "velvet-source-frame",
    "replaceable": true
  },
  "homeScene": {
    "enabled": true,
    "mode": "layered-architectural-home",
    "canvas": [1280, 2048],
    "entryDurationMs": 1100,
    "returnDurationMs": 520,
    "startupDelayMs": 900,
    "buildingLiftPx": 28,
    "assetOutline": {
      "baked": true,
      "color": "#0A0C0F",
      "buildingRadiusPx": 5,
      "foliageRadiusPx": 4,
      "preserveOriginalPixels": true
    },
    "motion": {
      "type": "converge",
      "travelFactor": 0.085,
      "verticalOffsetPx": 12,
      "foliageRisePx": 24
    },
    "replaceable": true,
    "background": {
      "id": "background",
      "asset": "./home-scene/00_background.webp",
      "depth": 0,
      "introStart": 0.0,
      "introEnd": 0.18
    },
    "layers": [
      {
        "id": "haussmann",
        "asset": "./home-scene/01_haussmann_left_far.webp",
        "side": "left",
        "depth": 10,
        "introStart": 0.06,
        "introEnd": 0.50
      },
      {
        "id": "collectif",
        "asset": "./home-scene/02_collectif_left_mid.webp",
        "side": "left",
        "depth": 11,
        "introStart": 0.12,
        "introEnd": 0.58
      },
      {
        "id": "poste-municipal",
        "asset": "./home-scene/03_poste_municipal_right_mid.webp",
        "side": "center",
        "depth": 12,
        "introStart": 0.18,
        "introEnd": 0.67
      },
      {
        "id": "building",
        "asset": "./home-scene/04_building_right_near.webp",
        "side": "right",
        "depth": 13,
        "introStart": 0.24,
        "introEnd": 0.74
      }
    ],
    "foliage": [
      {
        "id": "foliage-back",
        "asset": "./home-scene/10_foliage_back.webp",
        "depth": 30,
        "introStart": 0.40,
        "introEnd": 0.76
      },
      {
        "id": "foliage-mid",
        "asset": "./home-scene/11_foliage_mid.webp",
        "depth": 31,
        "introStart": 0.52,
        "introEnd": 0.88
      },
      {
        "id": "foliage-front",
        "asset": "./home-scene/12_foliage_front.webp",
        "depth": 32,
        "introStart": 0.62,
        "introEnd": 1.0
      }
    ]
  },
  "interface": {
    "experimentalSpiralDock": true,
    "experimentalBuildingScene": true,
    "premiumHome": true,
    "homeLayout": "architectural-premium",
    "surface": "#FFFDF8",
    "background": "#F4F1E8"
  }
}
