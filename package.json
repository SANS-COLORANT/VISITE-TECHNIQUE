{
  "name": "visite-technique",
  "version": "1.0.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "verify:metra": "node .github/scripts/run_source_patches.js",
    "prepare:metra": "npm run verify:metra",
    "prepare:metra:legacy": "node .github/scripts/apply_legacy_source_patches.js",
    "postinstall": "npm run verify:metra",
    "start": "expo start",
    "android": "expo start --android",
    "doctor": "npx --yes expo-doctor@1.20.4",
    "check:native": "npx expo install --check && npx --yes expo-doctor@1.20.4",
    "prebuild:android": "npx expo prebuild --clean --platform android",
    "build:apk": "npx eas-cli build -p android --profile preview",
    "build:aab": "npx eas-cli build -p android --profile production"
  },
  "dependencies": {
    "expo": "^54.0.37",
    "expo-asset": "~12.0.13",
    "expo-document-picker": "~14.0.8",
    "expo-file-system": "~19.0.24",
    "expo-image-manipulator": "~14.0.8",
    "expo-image-picker": "~17.0.11",
    "expo-linear-gradient": "~15.0.8",
    "expo-location": "~19.0.8",
    "expo-print": "~15.0.8",
    "expo-secure-store": "~15.0.8",
    "expo-sharing": "~14.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-sqlite": "~16.0.10",
    "pdf-lib": "^1.17.1",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-maps": "1.20.1",
    "react-native-svg": "15.12.1",
    "react-native-zip-archive": "7.1.1",
    "xlsx": "^0.18.5"
  },
  "overrides": {
    "@expo/xcpretty": "4.4.4"
  }
}
