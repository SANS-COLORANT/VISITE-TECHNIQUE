{
  "name": "visite-technique",
  "version": "1.0.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "verify:metra": "node .github/scripts/run_source_patches.js",
    "prepare:metra": "npm run verify:metra",
    "prepare:metra:legacy": "node .github/scripts/apply_legacy_source_patches.js",
    "postinstall": "npm run verify:metra",
    "start": "expo start",
    "android": "expo start --android",
    "doctor": "npx --yes expo-doctor@1.20.4",
    "check:native": "npx expo install --check && npx --yes expo-doctor@1.20.4",
    "prebuild:android": "npx expo prebuild --clean --platform android",
    "build:apk": "npx eas-cli build -p android --profile preview",
    "build:aab": "npx eas-cli build -p android --profile production"
  },
  "dependencies": {
    "expo": "^52.0.49",
    "expo-asset": "~11.0.5",
    "expo-document-picker": "~13.0.3",
    "expo-file-system": "~18.0.12",
    "expo-image-manipulator": "~13.0.6",
    "expo-image-picker": "~16.0.6",
    "expo-linear-gradient": "~14.0.2",
    "expo-location": "~18.0.10",
    "expo-print": "~14.0.3",
    "expo-secure-store": "~14.0.1",
    "expo-sharing": "~13.0.1",
    "expo-splash-screen": "~0.29.24",
    "expo-sqlite": "~15.1.4",
    "pdf-lib": "^1.17.1",
    "react": "18.3.1",
    "react-native": "0.76.9",
    "react-native-maps": "1.18.0",
    "react-native-svg": "15.8.0",
    "react-native-zip-archive": "7.1.1",
    "xlsx": "^0.18.5"
  },
  "overrides": {
    "@expo/xcpretty": "4.4.4"
  }
}
