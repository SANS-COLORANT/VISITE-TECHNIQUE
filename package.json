{
  "name": "visite-technique",
  "version": "1.0.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "verify:metra": "node .github/scripts/run_source_patches.js",
    "prepare:metra": "npm run verify:metra",
    "prepare:metra:legacy": "node .github/scripts/apply_legacy_source_patches.js",
    "postinstall": "npm run verify:metra",
    "start": "expo start",
    "android": "expo start --android",
    "doctor": "npx --yes expo-doctor@1.20.4",
    "check:native": "npx expo install --check && npx --yes expo-doctor@1.20.4",
    "prebuild:android": "npx expo prebuild --clean --platform android",
    "build:apk": "npx eas-cli build -p android --profile preview",
    "build:aab": "npx eas-cli build -p android --profile production"
  },
  "dependencies": {
    "expo": "51.0.39",
    "expo-asset": "~10.0.10",
    "expo-blur": "~13.0.2",
    "expo-document-picker": "~12.0.2",
    "expo-file-system": "~17.0.0",
    "expo-image-manipulator": "~12.0.5",
    "expo-image-picker": "~15.1.0",
    "expo-linear-gradient": "~13.0.2",
    "expo-location": "~17.0.1",
    "expo-print": "~13.0.1",
    "expo-secure-store": "~13.0.2",
    "expo-sharing": "~12.0.0",
    "expo-splash-screen": "~0.27.5",
    "expo-sqlite": "~14.0.0",
    "pdf-lib": "^1.17.1",
    "react": "18.2.0",
    "react-native": "0.74.5",
    "react-native-maps": "1.14.0",
    "react-native-svg": "15.2.0",
    "react-native-zip-archive": "7.1.1",
    "xlsx": "^0.18.5"
  },
  "overrides": {
    "@expo/xcpretty": "4.4.4"
  }
}
