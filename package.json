{
  "name": "visite-technique",
  "version": "1.0.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "engines": {
    "node": ">=20.19.4"
  },
  "scripts": {
    "verify:metra": "node .github/scripts/run_source_patches.js",
    "prepare:metra": "npm run verify:metra",
    "prepare:metra:legacy": "node .github/scripts/apply_legacy_source_patches.js",
    "postinstall": "npm run verify:metra",
    "start": "expo start",
    "android": "expo start --android",
    "doctor": "npx --yes expo-doctor@1.20.4",
    "check:native": "npx expo install --check && npx --yes expo-doctor@1.20.4",
    "prebuild:android": "npx expo prebuild --clean --platform android",
    "build:apk": "npx eas-cli build -p android --profile preview",
    "build:aab": "npx eas-cli build -p android --profile production"
  },
  "dependencies": {
    "expo": "^55.0.31",
    "expo-asset": "~55.0.20",
    "expo-document-picker": "~55.0.17",
    "expo-file-system": "~55.0.26",
    "expo-image-manipulator": "~55.0.21",
    "expo-image-picker": "~55.0.24",
    "expo-linear-gradient": "~55.0.18",
    "expo-location": "~55.1.14",
    "expo-print": "~55.0.19",
    "expo-secure-store": "~55.0.18",
    "expo-sharing": "~55.0.24",
    "expo-splash-screen": "~55.0.25",
    "expo-sqlite": "~55.0.20",
    "pdf-lib": "^1.17.1",
    "react": "19.2.0",
    "react-native": "0.83.10",
    "react-native-maps": "1.27.2",
    "react-native-svg": "15.15.3",
    "react-native-zip-archive": "7.1.1",
    "xlsx": "^0.18.5"
  },
  "overrides": {
    "@expo/xcpretty": "4.4.4"
  }
}
