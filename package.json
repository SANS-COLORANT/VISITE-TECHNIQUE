{
  "name": "visite-technique",
  "version": "1.0.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "verify:metra": "node .github/scripts/run_source_patches.js",
    "prepare:metra": "npm run verify:metra",
    "prepare:metra:legacy": "node .github/scripts/apply_legacy_source_patches.js",
    "postinstall": "npm run verify:metra",
    "start": "expo start",
    "android": "expo start --android",
    "doctor": "npx --yes expo-doctor@1.20.4",
    "check:native": "npx expo install --check && npx --yes expo-doctor@1.20.4",
    "prebuild:android": "npx expo prebuild --clean --platform android",
    "build:apk": "npx eas-cli build -p android --profile preview",
    "build:aab": "npx eas-cli build -p android --profile production"
  },
  "dependencies": {
    "expo": "^53.0.27",
    "expo-asset": "~11.1.7",
    "expo-document-picker": "~13.1.6",
    "expo-file-system": "~18.1.11",
    "expo-image-manipulator": "~13.1.7",
    "expo-image-picker": "~16.1.4",
    "expo-linear-gradient": "~14.1.5",
    "expo-location": "~18.1.6",
    "expo-print": "~14.1.4",
    "expo-secure-store": "~14.2.4",
    "expo-sharing": "~13.1.5",
    "expo-splash-screen": "~0.30.10",
    "expo-sqlite": "~15.2.14",
    "pdf-lib": "^1.17.1",
    "react": "19.0.0",
    "react-native": "0.79.6",
    "react-native-maps": "1.20.1",
    "react-native-svg": "15.11.2",
    "react-native-zip-archive": "7.1.1",
    "xlsx": "^0.18.5"
  },
  "overrides": {
    "@expo/xcpretty": "4.4.4"
  }
}
