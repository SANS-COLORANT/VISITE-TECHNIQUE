{
  "expo": {
    "name": "METRA",
    "slug": "visite-technique",
    "version": "1.0.0",
    "icon": "./assets/metra/app-icon.png",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "jsEngine": "hermes",
    "android": {
      "package": "com.visitetechnique.tablet",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/metra/adaptive-icon.png",
        "backgroundColor": "#FBF0E1"
      },
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "CAMERA"
      ],
      "blockedPermissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION"
      ]
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FBF0E1"
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Autoriser Visite Technique à utiliser l'appareil photo pour documenter les visites techniques.",
          "photosPermission": "Autoriser Visite Technique à accéder aux photos nécessaires aux visites techniques.",
          "microphonePermission": false
        }
      ]
    ],
    "extra": {
      "appMode": "native-tablet"
    }
  }
}
