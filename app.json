{
  "expo": {
    "name": "METRA",
    "slug": "visite-technique",
    "version": "1.0.0",
    "icon": "./assets/metra/app-icon.png",
    "orientation": "default",
    "userInterfaceStyle": "light",
    "jsEngine": "hermes",
    "android": {
      "package": "com.visitetechnique.tablet",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/metra/adaptive-icon.png",
        "backgroundColor": "#FBF0E1"
      },
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "CAMERA"
      ],
      "blockedPermissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FBF0E1",
          "image": "./assets/metra/app-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Autoriser Visite Technique à utiliser l'appareil photo pour documenter les visites techniques.",
          "photosPermission": "Autoriser Visite Technique à accéder aux photos nécessaires aux visites techniques.",
          "microphonePermission": false
        }
      ]
    ],
    "extra": {
      "appMode": "native-tablet"
    },
    "androidStatusBar": {
      "translucent": true,
      "backgroundColor": "#00000000",
      "barStyle": "dark-content"
    },
    "androidNavigationBar": {
      "backgroundColor": "#F3F1EC",
      "barStyle": "dark-content"
    },
    "newArchEnabled": false
  }
}
